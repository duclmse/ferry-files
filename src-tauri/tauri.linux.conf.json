{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "resources": {
      "libs/pdfium/libpdfium.so": "libpdfium.so",
      "libs/pdfium/PDFium-LICENSE.txt": "licenses/PDFium-LICENSE.txt",
      "libs/pdfium/PDFium-third-party-LICENSES.txt": "licenses/PDFium-third-party-LICENSES.txt"
    },
    "linux": {
      "deb": {
        "depends": ["libmtp9t64 | libmtp9"],
        "files": {
          "/usr/bin/ferry-fsd": "libs/fsd/bin/fsd"
        }
      },
      "rpm": {
        "depends": ["libmtp"],
        "files": {
          "/usr/bin/ferry-fsd": "libs/fsd/bin/fsd"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/ferry-fsd": "libs/fsd/bin/fsd"
        }
      }
    }
  },
  "build": {
    "beforeBundleCommand": "cargo install --locked --quiet --path fs/crates/fs-server --bin fsd --no-default-features --features ipc --root src-tauri/libs/fsd --target-dir target/ferry-fsd"
  }
}
