{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-devices",
    "allow-connect",
    "allow-disconnect",
    "allow-connections",
    "allow-info",
    "allow-list",
    "allow-refresh",
    "allow-read-text",
    "allow-write-text",
    "allow-mkdir",
