{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "bash scripts/bundle-libmtp.sh && bash scripts/fetch-pdfium.sh"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": ["libs/libmtp.9.dylib", "libs/libusb-1.0.0.dylib", "libs/pdfium/libpdfium.dylib"],
      "files": {
        "Resources/licenses/libmtp-COPYING.txt": "libs/libmtp-COPYING.txt",
        "Resources/licenses/libusb-COPYING.txt": "libs/libusb-COPYING.txt",
        "Resources/licenses/PDFium-LICENSE.txt": "libs/pdfium/PDFium-LICENSE.txt",
        "Resources/licenses/PDFium-third-party-LICENSES.txt": "libs/pdfium/PDFium-third-party-LICENSES.txt"
      }
    }
  }
}
